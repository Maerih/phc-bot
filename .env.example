# ─────────────────────────────────────────────────────────────
#  Public Health Colosseum — Platform Configuration
#  Powered by SCIAT SOLUTIONS
#
#  Copy to .env and fill in.  NEVER commit .env.
#  Only variables the code actually reads are listed here.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
LOG_LEVEL=info
TIMEZONE=Africa/Nairobi

# ── Database (required) ──────────────────────────────────────
# PostgreSQL connection string.
# Local user-space dev server (see scripts/dev-services.sh):
#   postgres://127.0.0.1:55432/phc
DATABASE_URL=postgres://127.0.0.1:55432/phc

# ── WhatsApp ─────────────────────────────────────────────────
# Only "baileys" is implemented. The bot owns its own WhatsApp
# number and stores auth state locally in WHATSAPP_AUTH_DIR.
WHATSAPP_PROVIDER=baileys
WHATSAPP_AUTH_DIR=./auth

# Pair with a phone number instead of scanning a QR code.
# Digits only, international format, no "+". Leave blank for QR.
WHATSAPP_PAIR_NUMBER=

# Command prefix.
COMMAND_PREFIX=.

# ── Administrators ───────────────────────────────────────────
# Comma-separated phone numbers, digits only, no "+".
# These numbers may run admin commands. Authorization is checked
# against the verified sender JID, never against the command name.
ADMIN_NUMBERS=

# ── Browser pairing page (only for hosts with no terminal) ───
# By default the WhatsApp QR is shown in the terminal only
# (./ctl.sh pair, or the console of npm start). Turn the web page
# on only for shared hosting, where there is no terminal.
# A QR is a credential — whoever scans it binds the bot to their
# account — so the page also needs a token.
# Generate one with:  openssl rand -hex 24
PAIRING_PAGE=off
ADMIN_PANEL_TOKEN=

# ── AI (optional — the platform runs fully without it) ───────
# Provider selection: gemini | anthropic | openai | none
#
# gemini is the default and the only one with a free tier.
# Get a free key at https://aistudio.google.com/apikey
# It also provides Google Search grounding, which powers the
# web fallback when the configured sources find nothing.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic — paid. A consumer Claude Pro/Max subscription does
# NOT include an API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI — provider not implemented yet (Phase 6).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Web search for the opportunity fallback ──────────────────
# Runs only when the configured sources return nothing.
#
#   tavily   free tier, key from https://app.tavily.com/   (easiest)
#   searxng  a SearXNG instance you host; no key, no quota (free forever)
#   provider the AI provider's own grounded search          (they bill it)
#   none     no web fallback
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
SEARXNG_URL=

# ── Opportunity sources ──────────────────────────────────────
# Comma-separated connector slugs to enable. Each runs
# independently; one failing source never stops the others.
# Available: remotive, arbeitnow, reliefweb
SOURCES_ENABLED=greenhouse,remotive,arbeitnow,jobicy,remoteok

# ReliefWeb — UN / NGO / global health vacancies with real
# deadlines. Free, but since 1 Nov 2025 the appname must be
# PRE-APPROVED by ReliefWeb.
#
#   1. Complete this short form:
#      https://docs.google.com/forms/d/e/1FAIpQLScR5EE_SBhweLLg_2xMCnXNbT6md4zxqIB00OL0yZWyrqX_Nw/viewform
#   2. Use a name made of: organisation + purpose + random chars
#      e.g.  phc-colosseum-opportunities-7f3a
#   3. ReliefWeb reviews it and emails you
#   4. Paste it below and add "reliefweb" to SOURCES_ENABLED
#
# Leave blank to keep the connector disabled.
RELIEFWEB_APPNAME=

# Employer career boards (Greenhouse). No key needed.
# One token per organisation — add any employer whose board is public at
# https://boards-api.greenhouse.io/v1/boards/<token>/jobs
# These are first-party postings, so they rank above aggregators.
GREENHOUSE_BOARDS=oneacrefund,resolvetosavelives,dimagi,givedirectly
