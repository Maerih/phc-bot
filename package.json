{
  "name": "phc-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Public Health Colosseum — AI-powered opportunity and community intelligence platform. Release 1.0 \"Neo\". Powered by SCIAT SOLUTIONS.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check": "npm run typecheck && npm run test",
    "search": "tsx src/cli/search.ts",
    "ai:check": "tsx src/cli/ai-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@hapi/boom": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.0.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
